{
  "realm": "Skoleoverblikket",
  "enabled": true,
  "displayName": "Skoleoverblikket",
  "sslRequired": "external",
  "loginTheme": "skoleoverblikket",
  "emailTheme": "skoleoverblikket",
  "internationalizationEnabled": true,
  "supportedLocales": ["da"],
  "defaultLocale": "da",

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@skoleoverblikket.dk",
    "fromDisplayName": "Skoleoverblikket",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,

  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "permanentLockout": false,

  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "School administrator — full access"
      },
      {
        "name": "teacher",
        "description": "Teacher — read-only access"
      },
      {
        "name": "aide",
        "description": "Pædagog / aide — read-only access"
      },
      {
        "name": "parent",
        "description": "Forælder — læseadgang til barnets klasse"
      },
      {
        "name": "superadmin",
        "description": "Platform superadmin — modul-override og administrationsadgang"
      },
      {
        "name": "board",
        "description": "Bestyrelsesmedlem — adgang til bestyrelsesmodul"
      }
    ]
  },

  "clients": [
    {
      "clientId": "skoleoverblikket-admin",
      "name": "Skoleoverblikket Admin (service account)",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,

      "secret": "skoleoverblikket-admin-secret",

      "defaultClientScopes": []
    },
    {
      "clientId": "skoleoverblikket-api",
      "name": "Skoleoverblikket API",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": true,

      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,

      "defaultClientScopes": [
        "roles"
      ]
    },
    {
      "clientId": "skoleoverblikket-web",
      "name": "Skoleoverblikket Web",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,

      "redirectUris": [
        "http://localhost:5173/*",
        "https://skoleoverblikket.dk/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://skoleoverblikket.dk"
      ],

      "defaultClientScopes": [
        "profile",
        "roles",
        "tenant"
      ],

      "protocolMappers": [
        {
          "name": "audience-skoleoverblikket-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "skoleoverblikket-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-skoleoverblikket-admin",
      "enabled": true,
      "serviceAccountClientId": "skoleoverblikket-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "username": "admin@debugskolen.dk",
      "email": "admin@debugskolen.dk",
      "firstName": "Debug",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,

      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],

      "realmRoles": ["admin", "superadmin"],

      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"]
      }
    }
  ],

  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID\",\"validations\":{},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },

  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "tenant",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "include.in.token.scope": "false"
          }
        }
      ]
    }
  ]
}
