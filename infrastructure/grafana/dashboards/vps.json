          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "rate(node_disk_io_time_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", device!~\"loop.*|sr.*\"}[$__rate_interval])",
