{
  "uid": "skoleoverblikket-vps",
  "title": "Skoleoverblikket – VPS",
  "description": "Host health per VPS: CPU, memory, disk, network, reboot pending and the journal, from Alloy.",
  "tags": [
    "skoleoverblikket",
    "vps"
  ],
  "timezone": "Europe/Copenhagen",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Skoleoverblikket",
      "type": "dashboards",
      "tags": [
        "skoleoverblikket"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Deploys / restarts",
        "expr": "{service_name=\"Skoleoverblikket.Api\"} | scope_name=\"Microsoft.Hosting.Lifetime\" |= \"Application started\"",
        "titleFormat": "API started",
        "textFormat": "instance {{service_instance_id}}",
        "instant": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "definition": "label_values(up{job=\"integrations/node_exporter\"}, service)",
        "query": {
          "query": "label_values(up{job=\"integrations/node_exporter\"}, service)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "definition": "label_values(up{job=\"integrations/node_exporter\", service=~\"$service\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"integrations/node_exporter\", service=~\"$service\"}, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Hosts (now)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 2,
      "title": "Hosts",
      "description": "One row per host. DOWN = reported in the last day but not now: the VPS is down or Alloy can't reach Grafana (check Alloy errors below). Load is per CPU core; above 1 means work is queuing.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "max by (instance) (up{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}) or max by (instance) (last_over_time(up{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}[1d])) * 0",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", mode=\"idle\"}[5m]))",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "C",
          "expr": "max by (instance) (node_load5{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}) / count by (instance) (node_cpu_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", mode=\"idle\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "D",
          "expr": "1 - max by (instance) (node_memory_MemAvailable_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}) / max by (instance) (node_memory_MemTotal_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "E",
          "expr": "1 - max by (instance) (node_memory_SwapFree_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}) / max by (instance) (node_memory_SwapTotal_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"} > 0)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "F",
          "expr": "1 - min by (instance) (node_filesystem_avail_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", fstype=~\"ext4|xfs\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "G",
          "expr": "max by (instance) (node_reboot_required{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "H",
          "expr": "time() - max by (instance) (node_boot_time_seconds{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "instance": "Host",
              "Value #A": "Status",
              "Value #B": "CPU",
              "Value #C": "Load 5m / core",
              "Value #D": "Memory",
              "Value #E": "Swap",
              "Value #F": "Fullest disk",
              "Value #G": "Reboot pending",
              "Value #H": "Uptime"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "green"
                      },
                      "0": {
                        "text": "DOWN",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "CPU|Memory|Fullest disk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Swap"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.25
                    },
                    {
                      "color": "red",
                      "value": 0.75
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Load 5m / core"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reboot pending"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "yes",
                        "color": "orange"
                      },
                      "0": {
                        "text": "no",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "id": 3,
      "title": "CPU and memory",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "CPU",
      "description": "Share of all cores. iowait = waiting on disk. steal = other tenants on the OVH host taking our CPU; steady steal means the VPS plan is oversold, not that our code is slow.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} used",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "expr": "avg by (instance, mode) (rate(node_cpu_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", mode=~\"iowait|steal\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{mode}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Load per core",
      "description": "Runnable plus disk-waiting processes per core. Short spikes during builds and deploys are normal; a 5m value above 1 for long means the host is too small.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "max by (instance) (node_load1{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}) / count by (instance) (node_cpu_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", mode=\"idle\"})",
          "legendFormat": "{{instance}} 1m",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "expr": "max by (instance) (node_load5{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}) / count by (instance) (node_cpu_seconds_total{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", mode=\"idle\"})",
          "legendFormat": "{{instance}} 5m",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Memory",
      "description": "Used = total minus available (page cache doesn't count). Swap is a safety net for builds (swappiness 10); swap that keeps growing means the host needs more RAM.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "max by (instance) (node_memory_MemTotal_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"} - node_memory_MemAvailable_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} used",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "expr": "max by (instance) (node_memory_SwapTotal_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"} - node_memory_SwapFree_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} swap used",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "C",
          "expr": "max by (instance) (node_memory_MemTotal_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} total",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* total"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "OOM kills",
      "description": "The kernel killed a process for lack of memory. Usually a build or a container without a memory limit. Find the victim in 'Host errors' below.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum by (instance) (increase(node_vmstat_oom_kill{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "Disk and network",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Disk used",
      "description": "Docker images, build cache and Postgres WAL live here. The weekly prune (Sun 06:30) should give a saw-tooth; a steady climb is logs or volumes. The 'disk almost full' alert fires before it runs out.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{job=\"integrations/node_exporter\", service=~\"$service\", instance=~\"$instance\", fstype=~\"ext4|xfs\"}",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Disk busy",
