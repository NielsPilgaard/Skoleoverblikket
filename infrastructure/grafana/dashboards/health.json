          "refId": "A",
          "expr": "sum by (route, StatusCode) (count_over_time({service_name=\"Skoleoverblikket.Api\"} | event_name=\"ResponseLog\" | RequestPath!~\"/alive|/health\" | StatusCode=~\"5..\" | label_format route=`{{ regexReplaceAll \"[0-9]{4}-[0-9]{2}-[0-9]{2}\" (regexReplaceAll \"[0-9]{4}-W[0-9]{2}\" (regexReplaceAll \"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\" .RequestPath \"{id}\") \"{week}\") \"{date}\" }}` [$__interval]))",
          "legendFormat": "{{StatusCode}} {{route}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
