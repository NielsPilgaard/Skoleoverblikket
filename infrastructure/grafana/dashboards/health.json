        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.5, {service_name=\"Skoleoverblikket.Api\"} | event_name=\"Duration\" | RequestPath!~\"/alive|/health\" | RequestPath=~\"/api/v1/.*\" | unwrap Duration [$__interval]) by (service_name)",
          "legendFormat": "p50",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service_name=\"Skoleoverblikket.Api\"} | event_name=\"Duration\" | RequestPath!~\"/alive|/health\" | RequestPath=~\"/api/v1/.*\" | unwrap Duration [$__interval]) by (service_name)",
          "legendFormat": "p95",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "C",
          "expr": "quantile_over_time(0.99, {service_name=\"Skoleoverblikket.Api\"} | event_name=\"Duration\" | RequestPath!~\"/alive|/health\" | RequestPath=~\"/api/v1/.*\" | unwrap Duration [$__interval]) by (service_name)",
          "legendFormat": "p99",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "pointSize": 6
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "5xx by route",
      "description": "Server errors. Each one is a school user who hit a broken page.",
      "gridPos": {
