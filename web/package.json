{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run api:generate && tsc -b && vite build && npm run prerender",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "biome check src/",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "preview": "vite preview",
    "api:generate": "openapi-ts -f openapi-ts.config.ts",
    "codegen": "dotnet build ../api/Skoleoverblikket.Api/Skoleoverblikket.Api.csproj -nologo -v q -clp:ErrorsOnly -p:OutDir=bin/codegen/ && openapi-ts -f openapi-ts.config.ts --silent --no-log-file",
    "test:e2e": "playwright test",
    "test:e2e:skip-aspire": "SKIP_ASPIRE=1 playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "keycloak-js": "^26.2.5",
    "mammoth": "^1.13.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "remark-breaks": "^4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  }
}
