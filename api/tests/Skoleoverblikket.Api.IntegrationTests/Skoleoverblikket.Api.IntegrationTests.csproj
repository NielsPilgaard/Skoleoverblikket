<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    
    <!-- Required for Microsoft.Testing.Platform -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Skoleoverblikket.Api\Skoleoverblikket.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.16.0" />
    <PackageReference Include="Testcontainers.Minio" Version="4.15.0" />
    <PackageReference Include="TUnit" Version="1.84.0" />
    <PackageReference Include="TUnit.AspNetCore" Version="1.84.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />

    <!-- Npgsql 10.0.3 depends on EFCore.Relational 10.0.4, but the API uses EF Core 10.0.15.
         Pin Relational to the API's EF Core version so both assemblies agree at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
  </ItemGroup>

</Project>
