<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    
    <!-- Required for Microsoft.Testing.Platform -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Skoleoverblikket.Api\Skoleoverblikket.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.12.0" />
    <PackageReference Include="Testcontainers.Minio" Version="4.12.0" />
    <PackageReference Include="TUnit" Version="1.43.2" />
    <PackageReference Include="TUnit.AspNetCore" Version="1.43.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />

    <!-- Npgsql 10.0.1 depends on EFCore.Relational 10.0.4, but the API uses 10.0.5.
         Pin Relational to 10.0.5 so both assemblies agree at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
  </ItemGroup>

</Project>
